# ===============================
# DeepEVAL AI - Variables de entorno
# ===============================

# Google Gemini
# Crear API Key en: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=pegue_aqui_su_api_key_de_google

# OpenAI GPT
# Crear API Key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=pegue_aqui_su_api_key_de_openai

# Ollama local
# Debe tener Ollama activo en http://127.0.0.1:11434
OLLAMA_MODEL=ollama/llama3.2:3b

# Modelos recomendados
GEMINI_MODEL=google/gemini-2.5-flash
GPT_MODEL=openai/gpt-4.1-mini
