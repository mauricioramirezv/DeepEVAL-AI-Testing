# ===============================
# DeepEVAL AI - Configuración de ejemplo
# ===============================

# Stagehand v4 / Google AI Studio
GOOGLE_GENERATIVE_AI_API_KEY=pegue_aqui_su_api_key_de_google
# DeepEval GeminiModel usa GOOGLE_API_KEY
GOOGLE_API_KEY=pegue_aqui_su_api_key_de_google
GEMINI_API_KEY=pegue_aqui_su_api_key_de_google
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EVAL_MODEL=gemini-3.8-flash

# OpenAI
OPENAI_API_KEY=pegue_aqui_su_api_key_de_openai
OPENAI_MODEL=gpt-6-astra
OPENAI_EVAL_MODEL=gpt-5.4

# Ollama local: instalar el modelo con `ollama pull qwen3.5:4b`
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Proveedor juez de DeepEval: gemini, openai u ollama
EVAL_PROVIDER=gemini

# Stagehand v4 se ejecuta en segundo plano por defecto. Usa false para mostrar el navegador.
HEADLESS=true
